{
  "name": "p2pcord",
  "productName": "P2Pcord",
  "version": "0.1.0",
  "upgrade": "pear://PLACEHOLDER",
  "description": "Serverloser, Ende-zu-Ende-verschlüsselter Voice- und Text-Chat für Freunde (P2P, Holepunch-Stack)",
  "license": "Apache-2.0",
  "author": "louiswalder6",
  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build:db": "node schema.js",
    "build:ui": "node scripts/fetch-models.mjs && vite build --config renderer/vite.config.mjs",
    "dev:ui": "vite build --watch --config renderer/vite.config.mjs",
    "build": "npm run build:db && npm run build:ui",
    "start": "npm run build && electron-forge start -- --no-updates",
    "start:peer": "electron-forge start -- --no-updates --storage",
    "test": "brittle-node test/*.test.js",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make --targets pear-electron-forge-maker-appimage",
    "make:win": "npm run build && electron-forge make --platform win32 --targets @electron-forge/maker-zip"
  },
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "dependencies": {
    "autobase": "^7.28.2",
    "b4a": "^1.9.0",
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.2",
    "bare-path": "^3.1.2",
    "bare-storage": "^1.1.0",
    "blind-pairing": "^2.3.1",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.12.6",
    "debounceify": "^1.1.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperblobs": "^2.12.1",
    "hypercore-crypto": "^3.7.0",
    "hyperdb": "^6.9.0",
    "hyperdispatch": "^1.6.0",
    "hyperschema": "^1.26.2",
    "hyperswarm": "^4.17.2",
    "paparam": "^1.13.0",
    "pear-link": "^5.0.1",
    "pear-runtime": "^1.3.1",
    "protomux": "^3.12.1",
    "ready-resource": "^1.2.0",
    "sodium-universal": "^5.0.1",
    "streamx": "^2.28.1",
    "which-runtime": "^1.4.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-msix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "app-builder-lib": "^26.15.3",
    "brittle": "^4.2.0",
    "deepfilternet3-noise-filter": "^1.3.0",
    "electron": "^40.10.6",
    "electron-forge-plugin-prune-prebuilds": "^1.0.1",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "hyperdht": "^6.34.0",
    "pear-electron-forge-maker-appimage": "^2.0.1",
    "svelte": "^5.57.1",
    "test-tmp": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
